{
    "name": "wppoland/finder",
    "description": "Friendly step-by-step product finder quiz for WooCommerce - guided single-choice questions map to one product recommendation. Accessible, no jQuery, zero layout shift, REST-powered.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^1.10",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "php-stubs/woocommerce-stubs": "10.8.0"
    },
    "autoload": {
        "psr-4": {
            "Finder\\": "src/",
            "WPPoland\\StorefrontKit\\": "lib/storefront-kit/"
        }
    },
    "scripts": {
        "cs": "phpcs --standard=phpcs.xml.dist",
        "cs:fix": "phpcbf --standard=phpcs.xml.dist",
        "analyse": "phpstan analyse -c phpstan.neon.dist --memory-limit=2G"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
