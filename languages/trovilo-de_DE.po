#. Plugin Name of the plugin
#: trovilo.php
msgid "Plogins Finder - Product Finder Quiz for WooCommerce"
msgstr "Plogins Finder, Produktfinder-Quiz für WooCommerce"

#. Plugin URI of the plugin
#: trovilo.php
msgid "https://plogins.com/trovilo/"
msgstr "https://plogins.com/de/trovilo/"

#. Description of the plugin
#: trovilo.php
msgid ""
"Friendly step-by-step product finder quiz for WooCommerce - guided single-"
"choice questions map to one product recommendation. Accessible, no jQuery, "
"zero layout shift, REST-powered."
msgstr ""
"Freundliches Schritt-für-Schritt-Produktfinder-Quiz für WooCommerce, "
"geführte Fragen mit Einfachauswahl führen zu einer einzigen "
"Produktempfehlung. Barrierefrei, ohne jQuery, ohne Layout-Verschiebung, per "
"REST."

#. Author of the plugin
#: trovilo.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

#. Author URI of the plugin
#: trovilo.php
msgid "https://wppoland.com"
msgstr "https://wppoland.com"

